# Identity
SERVICE_NAME=Code Graph Helper API
ENVIRONMENT=development
DEBUG=false
PORT=8687

# Auth
ENABLE_AUTH=false
ENABLE_DOCS=true
DEFAULT_TENANT_ID=n8n-dev

# Database
DATABASE_URL=postgresql+psycopg://codegraph:codegraph@postgres:5432/codegraph

# Redis
REDIS_URL=redis://code-graph-redis:6379/0

# Backend services
ANALYSIS_URL=http://coding-analysis:8688
TESTING_URL=http://coding-testing:8689
AI_URL=http://coding-ai:8690
CONTAINERS_URL=http://coding-containers:8691
GITHUB_URL=http://coding-github:8692
SECURITY_URL=http://coding-security:8693
REALTIME_URL=http://coding-realtime:8694

# Observability
OTEL_ENDPOINT=http://otel-collector:4318
LOG_LEVEL=DEBUG

# Secrets (uncomment and set)
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# SECRET_KEY=
